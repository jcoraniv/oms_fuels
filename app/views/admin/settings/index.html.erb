<div class="content-header">
  <div class="container-fluid">
    <div class="row mb-2">
      <div class="col-sm-6">
        <h1 class="m-0">Settings</h1>
      </div>
    </div>
  </div>
</div>

<div class="content">
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-8">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title"><i class="bi bi-bell"></i> Push Notifications</h3>
          </div>
          <div class="card-body">
            <p class="text-muted">
              Enable push notifications to receive real-time alerts about fuel orders directly in your browser.
            </p>
            
            <div id="push-notification-status" class="alert alert-info d-none">
              <i class="bi bi-info-circle"></i> <span id="status-message"></span>
            </div>

            <div class="d-flex gap-2">
              <button id="enable-push" class="btn btn-primary" style="display: none;">
                <i class="bi bi-bell"></i> Enable Notifications
              </button>
              <button id="disable-push" class="btn btn-secondary" style="display: none;">
                <i class="bi bi-bell-slash"></i> Disable Notifications
              </button>
            </div>

            <div class="mt-3">
              <small class="text-muted">
                <strong>What you'll receive:</strong><br>
                <% if current_user.admin? %>
                  • All new fuel orders<br>
                <% elsif current_user.operation? %>
                  • Fuel orders where you are the approver<br>
                <% else %>
                  • Updates when your fuel orders are approved<br>
                <% end %>
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', async function() {
  const enableBtn = document.getElementById('enable-push');
  const disableBtn = document.getElementById('disable-push');
  const statusDiv = document.getElementById('push-notification-status');
  const statusMessage = document.getElementById('status-message');

  function showStatus(message, type = 'info') {
    statusDiv.className = `alert alert-${type}`;
    statusDiv.classList.remove('d-none');
    statusMessage.textContent = message;
  }

  if (!enableBtn || !disableBtn) return;
  
  if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
    showStatus('Push notifications are not supported in your browser.', 'warning');
    return;
  }

  try {
    const registration = await navigator.serviceWorker.ready;
    const subscription = await registration.pushManager.getSubscription();
    
    if (subscription) {
      disableBtn.style.display = 'inline-block';
      showStatus('Push notifications are enabled.', 'success');
    } else {
      enableBtn.style.display = 'inline-block';
      showStatus('Push notifications are disabled.', 'secondary');
    }

    enableBtn.addEventListener('click', async () => {
      try {
        await window.pushNotifications.subscribe();
        enableBtn.style.display = 'none';
        disableBtn.style.display = 'inline-block';
        showStatus('Push notifications enabled successfully!', 'success');
      } catch (error) {
        showStatus('Failed to enable notifications. Please check your browser permissions.', 'danger');
      }
    });

    disableBtn.addEventListener('click', async () => {
      try {
        await window.pushNotifications.unsubscribe();
        disableBtn.style.display = 'none';
        enableBtn.style.display = 'inline-block';
        showStatus('Push notifications disabled.', 'secondary');
      } catch (error) {
        showStatus('Failed to disable notifications.', 'danger');
      }
    });
  } catch (error) {
    console.error('Error checking push subscription:', error);
    showStatus('Error checking notification status.', 'danger');
  }
});
</script>
