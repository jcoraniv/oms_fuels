<div class="content-header">
  <div class="container-fluid">
    <div class="row mb-2">
      <div class="col-sm-6">
        <h1 class="m-0"><%= t('admin.gestions.title') %></h1>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h3 class="card-title"><%= t('admin.gestions.title') %></h3>
    <% if current_user.admin? %>
      <div class="card-tools">
        <%= link_to t('admin.gestions.new'), new_admin_gestion_path, class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
  <div class="card-body p-0">
    <table class="table table-striped">
      <thead>
        <tr>
          <th><%= t('admin.gestions.table.code') %></th>
          <th><%= t('admin.gestions.table.name') %></th>
          <th><%= t('admin.gestions.table.active') %></th>
          <th style="width: 150px"><%= t('common.actions') %></th>
        </tr>
      </thead>
      <tbody>
        <% @gestions.each do |gestion| %>
          <tr>
            <td><%= gestion.code %></td>
            <td><%= gestion.name %></td>
            <td>
              <% if gestion.active? %>
                <span class="badge bg-success"><%= t('admin.gestions.table.status_active') %></span>
              <% else %>
                <span class="badge bg-danger"><%= t('admin.gestions.table.status_inactive') %></span>
              <% end %>
            </td>
            <td>
              <%= action_button(:edit, edit_admin_gestion_path(gestion)) %>
              <%= action_button(:delete, admin_gestion_path(gestion), turbo_method: :delete, data: { turbo_confirm: t('common.confirm_delete') }) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
