<% content_for :page_title do %>
  <%= link_to t('admin.menu.fuel_orders'), admin_fuel_orders_path %> /
  <%= @fuel_order.formatted_number %>
<% end %>

<% 
  badge_color = case @fuel_order.status
  when 'pending' then 'warning'
  when 'approved' then 'success'
  when 'completed' then 'info'
  when 'canceled' then 'danger'
  end
%>
<div class="card card-<%= badge_color %>">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start">
      <div>
        <p><strong><%= t('admin.fuel_orders.table.number') %>:</strong> <%= @fuel_order.formatted_number %></p>
        <p><strong><%= t('admin.fuel_orders.table.requester') %>:</strong> <%= @fuel_order.requester_assignment.personal.full_name %></p>
        <p><strong>Vehicle:</strong> <%= @fuel_order.fuel_order_items.first&.vehicle&.plate || 'N/A' %></p>
      </div>
      <div class="text-center">
        <span class="badge bg-<%= badge_color %> fs-5"><%= t("admin.fuel_orders.status.#{@fuel_order.status}") %></span>
        <% if @fuel_order.approver_assignment %>
          <div class="mt-2 text-muted small">
            <strong><%= @fuel_order.canceled? ? t('admin.fuel_orders.form.rejected_by') : t('admin.fuel_orders.form.approver') %></strong><br>
            <%= @fuel_order.approver_assignment.personal.full_name %>
          </div>
        <% end %>
      </div>
    </div>

    <h4 class="mt-4 mb-3"><%= t('admin.fuel_orders.items.title') %></h4>

    <table class="table table-bordered">
      <thead>
        <tr>
          <th><%= t('admin.fuel_orders.items.fuel') %></th>
          <th class="text-end"><%= t('admin.fuel_orders.items.quantity') %></th>
          <th class="text-end"><%= t('admin.fuel_orders.items.unit_price') %></th>
          <th class="text-end">Total</th>
        </tr>
      </thead>
      <tbody>
        <% @fuel_order.fuel_order_items.each do |item| %>
          <tr>
            <td><%= item.fuel.description %></td>
            <td class="text-end"><%= number_with_precision(item.quantity_ordered, precision: 2) %></td>
            <td class="text-end"><%= number_to_currency(item.unit_price) %></td>
            <td class="text-end"><%= number_to_currency(item.partial_price) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="3" class="text-end"><strong><%= t('admin.fuel_orders.table.total') %>:</strong></td>
          <td class="text-end"><strong><%= number_to_currency(@fuel_order.total) %></strong></td>
        </tr>
      </tfoot>
    </table>
  </div>
  <div class="card-footer d-flex justify-content-end gap-2">
    <% if policy(@fuel_order).update? && @fuel_order.pending? %>
      <%= link_to edit_admin_fuel_order_path(@fuel_order), class: 'btn btn-warning btn-sm' do %>
        <i class="bi bi-pencil"></i> <%= t('common.edit') %>
      <% end %>
    <% end %>
    <% if policy(@fuel_order).approve? && @fuel_order.pending? %>
      <%= button_to approve_admin_fuel_order_path(@fuel_order), method: :patch, class: 'btn btn-success btn-sm' do %>
        <i class="bi bi-check-circle"></i> <%= t('common.approve') %>
      <% end %>
    <% end %>
    <% if policy(@fuel_order).cancel? && (@fuel_order.pending? || @fuel_order.approved?) %>
      <%= button_to cancel_admin_fuel_order_path(@fuel_order), method: :patch, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger btn-sm' do %>
        <i class="bi bi-x-circle"></i> <%= t('common.cancel') %>
      <% end %>
    <% end %>
    <% if policy(@fuel_order).complete? && @fuel_order.approved? %>
      <%= button_to complete_admin_fuel_order_path(@fuel_order), method: :patch, class: 'btn btn-primary btn-sm' do %>
        <i class="bi bi-flag-checkered"></i> <%= t('common.complete') %>
      <% end %>
    <% end %>
    <% if @fuel_order.completed? %>
      <%= link_to admin_fuel_order_path(@fuel_order, format: :pdf), target: "_blank", class: 'btn btn-info btn-sm' do %>
        <i class="bi bi-printer"></i> <%= t('common.print') %>
      <% end %>
    <% end %>
  </div>
</div>
