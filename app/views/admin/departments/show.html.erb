<% content_for :page_title do %>
  <%= link_to t('admin.menu.departments'), admin_departments_path %> /
  <%= @org_structure.department.name %>
<% end %>

<div class="card card-info">
  <div class="card-body">
    <div class="d-flex justify-content-end mb-3">
      <%= link_to edit_admin_department_path(@org_structure), class: 'btn btn-warning btn-sm' do %>
        <i class="bi bi-pencil"></i>
      <% end %>
    </div>
    <dl class="row">
      <dt class="col-sm-3"><%= t('admin.departments.table.name') %></dt>
      <dd class="col-sm-9"><%= @org_structure.department.name %></dd>
      
      <dt class="col-sm-3"><%= t('admin.menu.gestions') %></dt>
      <dd class="col-sm-9"><%= @org_structure.gestion.name %></dd>
      
      <dt class="col-sm-3"><%= t('admin.departments.table.parent_department') %></dt>
      <dd class="col-sm-9">
        <% if @org_structure.parent_dept %>
          <%= @org_structure.parent_dept.department.name %>
        <% else %>
          <span class="text-muted"><%= t('admin.departments.show.no_parent') %></span>
        <% end %>
      </dd>
    </dl>
  </div>
</div>
