<% content_for :page_title, t('admin.departments.title') %>
<% content_for :page_actions do %>
  <%= link_to t('admin.departments.new'), new_admin_department_path, class: 'btn btn-primary' %>
<% end %>

<div class="card">
  <div class="card-body p-0">
    <table class="table table-bordered table-hover dataTable dtr-inline">
      <thead>
        <tr>
          <th><%= t('admin.departments.table.name') %></th>
          <th><%= t('admin.departments.table.parent_department') %></th>
          <th style="width: 150px"><%= t('common.actions') %></th>
        </tr>
      </thead>
      <tbody>
        <% @org_structures.each do |org_structure| %>
          <tr>
            <td><%= link_to org_structure.department.name, admin_department_path(org_structure), class: "text-primary" %></td>
            <td>
              <% if org_structure.parent_dept %>
                <%= org_structure.parent_dept.department.name %>
              <% else %>
                <span class="text-muted">-</span>
              <% end %>
            </td>
            <td>
              <%= action_button(:edit, edit_admin_department_path(org_structure)) %>
              <%= action_button(:delete, admin_department_path(org_structure), method: :delete, data: { turbo_confirm: t('common.confirm_delete') }) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="card-footer clearfix">
    <%= paginate @org_structures %>
  </div>
</div>
