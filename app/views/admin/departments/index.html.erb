<div class="content-header">
  <div class="container-fluid">
    <div class="row mb-2">
      <div class="col-sm-6">
        <h1 class="m-0">Departments</h1>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h3 class="card-title">Departments</h3>
    <div class="card-tools">
      <%= link_to 'New Department', new_admin_department_path, class: "btn btn-primary" %>
    </div>
  </div>
  <div class="card-body p-0">
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Name</th>
          <th>Parent Department</th>
          <th style="width: 150px">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @org_structures.each do |org_structure| %>
          <tr>
            <td><%= link_to org_structure.department.name, admin_department_path(org_structure), class: "text-primary" %></td>
            <td>
              <% if org_structure.parent_dept %>
                <%= org_structure.parent_dept.department.name %>
              <% else %>
                <span class="text-muted">-</span>
              <% end %>
            </td>
            <td>
              <%= action_button(:edit, edit_admin_department_path(org_structure)) %>
              <%= action_button(:delete, admin_department_path(org_structure), method: :delete, data: { turbo_confirm: t('common.confirm_delete') }) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
