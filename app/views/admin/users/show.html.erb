<% content_for :page_title do %>
  <%= link_to t('admin.menu.users'), admin_users_path %> /
  <%= @user.full_name %>
<% end %>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-end mb-3">
      <%= link_to edit_admin_user_path(@user), class: 'btn btn-warning btn-sm' do %>
        <i class="bi bi-pencil"></i>
      <% end %>
    </div>
    <dl class="row">
      <dt class="col-sm-3"><%= t('activerecord.attributes.user.username') %></dt>
      <dd class="col-sm-9"><%= @user.username %></dd>

      <dt class="col-sm-3"><%= t('admin.users.table.full_name') %></dt>
      <dd class="col-sm-9"><%= @user.full_name %></dd>

      <dt class="col-sm-3"><%= t('activerecord.attributes.user.role') %></dt>
      <dd class="col-sm-9"><%= t("activerecord.attributes.user.roles.#{@user.role.name.downcase}") %></dd>

      <dt class="col-sm-3"><%= t('activerecord.attributes.user.active') %></dt>
      <dd class="col-sm-9">
        <% if @user.active? %>
          <span class="badge bg-success"><%= t('admin.users.table.active') %></span>
        <% else %>
          <span class="badge bg-danger"><%= t('admin.users.table.inactive') %></span>
        <% end %>
      </dd>

      <dt class="col-sm-3"><%= t('activerecord.attributes.personal.ci') %></dt>
      <dd class="col-sm-9"><%= @user.personal.ci %></dd>

      <dt class="col-sm-3"><%= t('activerecord.attributes.personal.email') %></dt>
      <dd class="col-sm-9"><%= @user.personal.email || "N/A" %></dd>

      <dt class="col-sm-3"><%= t('activerecord.attributes.personal.phone') %></dt>
      <dd class="col-sm-9"><%= @user.personal.phone || "N/A" %></dd>
    </dl>
  </div>
</div>
