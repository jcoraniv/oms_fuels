<% content_for :page_title do %>
  <%= link_to t('admin.menu.users'), admin_users_path %> /
  <%= @user.full_name %>
<% end %>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-end mb-3">
      <%= link_to edit_admin_user_path(@user), class: 'btn btn-warning btn-sm' do %>
        <i class="bi bi-pencil"></i>
      <% end %>
    </div>
    <dl class="row">
      <dt class="col-sm-3">Email:</dt>
      <dd class="col-sm-9"><%= @user.username %></dd>

      <dt class="col-sm-3">Name:</dt>
      <dd class="col-sm-9"><%= @user.full_name %></dd>

      <dt class="col-sm-3">Role:</dt>
      <dd class="col-sm-9"><%= @user.role.name %></dd>

      <dt class="col-sm-3">Status:</dt>
      <dd class="col-sm-9">
        <% if @user.active? %>
          <span class="badge bg-success">Active</span>
        <% else %>
          <span class="badge bg-danger">Inactive</span>
        <% end %>
      </dd>

      <dt class="col-sm-3">CI:</dt>
      <dd class="col-sm-9"><%= @user.personal.ci %></dd>

      <dt class="col-sm-3">Personal Email:</dt>
      <dd class="col-sm-9"><%= @user.personal.email || "N/A" %></dd>

      <dt class="col-sm-3">Phone:</dt>
      <dd class="col-sm-9"><%= @user.personal.phone || "N/A" %></dd>
    </dl>
  </div>
</div>
