<div class="content-header">
  <div class="container-fluid">
    <div class="row mb-2">
      <div class="col-sm-6">
        <h1 class="m-0"><%= t('admin.users.title') %></h1>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h3 class="card-title"><%= t('admin.users.title') %></h3>
    <div class="card-tools">
      <%= link_to t('admin.users.new'), new_admin_user_path, class: "btn btn-primary" %>
    </div>
  </div>
  <div class="card-body">
    <%= search_form_for @q, url: admin_users_path, method: :get, html: { class: 'mb-3' } do |f| %>
      <div class="row">
        <div class="col-md-4">
          <%= f.text_field :email_cont, class: 'form-control', placeholder: 'Search by email' %>
        </div>
        <div class="col-md-4">
          <%= f.text_field :personal_first_name_or_personal_last_name_cont, class: 'form-control', placeholder: 'Search by name' %>
        </div>
        <div class="col-md-4">
          <%= f.submit 'Search', class: 'btn btn-primary' %>
          <%= link_to 'Reset', admin_users_path, class: 'btn btn-secondary' %>
        </div>
      </div>
    <% end %>
  </div>
  <div class="card-body p-0">
    <table class="table table-striped">
      <thead>
        <tr>
          <th><%= t('admin.users.table.full_name') %></th>
          <th><%= t('admin.users.table.email') %></th>
          <th><%= t('admin.users.table.role') %></th>
          <th><%= t('admin.users.table.status') %></th>
          <th style="width: 150px"><%= t('common.actions') %></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= link_to user.full_name, admin_user_path(user), class: "text-primary" %></td>
            <td><%= user.email %></td>
            <td><span class="badge bg-secondary"><%= user.role.name %></span></td>
            <td>
              <span class="badge bg-<%= user.active? ? 'success' : 'danger' %>"><%= user.status.titleize %></span>
            </td>
            <td>
              <%= action_button(:edit, edit_admin_user_path(user)) %>
              <%= action_button(:delete, admin_user_path(user), method: :delete, data: { turbo_confirm: t('common.confirm_delete') }) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="card-footer clearfix">
    <%= paginate @users %>
  </div>
</div>
