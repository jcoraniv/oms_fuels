<%= render 'shared/content_header' %>
<% content_for :page_title, t('admin.professions.title') %>
<% content_for :page_actions do %>
  <%= link_to t('admin.professions.new'), new_admin_profession_path, class: 'btn btn-primary' %>
<% end %>

<div class="card">
  <div class="card-body p-0">
    <table class="table table-bordered table-hover dataTable dtr-inline">
      <thead>
        <tr>
          <th><%= t('admin.professions.table.name') %></th>
          <th style="width: 150px"><%= t('common.actions') %></th>
        </tr>
      </thead>
      <tbody>
        <% @professions.each do |profession| %>
          <tr>
            <td><%= link_to profession.name, admin_profession_path(profession), class: "text-primary" %></td>
            <td>
              <%= action_button(:edit, edit_admin_profession_path(profession)) %>
              <%= action_button(:delete, admin_profession_path(profession), turbo_method: :delete, data: { turbo_confirm: t('common.confirm_delete') }) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="card-footer clearfix">
    <%= paginate @professions %>
  </div>
</div>
