<% content_for :page_title do %>
  <%= link_to t('admin.menu.professions'), admin_professions_path %> /
  <%= @profession.name %>
<% end %>

<div class="card card-info">
  <div class="card-body">
    <div class="d-flex justify-content-end mb-3">
      <%= link_to edit_admin_profession_path(@profession), class: 'btn btn-warning btn-sm' do %>
        <i class="bi bi-pencil"></i>
      <% end %>
    </div>
    <p><strong><%= t('activerecord.attributes.profession.name') %>:</strong> <%= @profession.name %></p>
  </div>
</div>
