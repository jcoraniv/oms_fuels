<% content_for :page_title do %>
  <%= link_to t('admin.menu.positions'), admin_positions_path %> /
  <%= @org_position.position.name %>
<% end %>

<div class="card card-info">
  <div class="card-body">
    <div class="d-flex justify-content-end mb-3">
      <%= link_to edit_admin_position_path(@org_position), class: 'btn btn-warning btn-sm' do %>
        <i class="bi bi-pencil"></i>
      <% end %>
    </div>
    <dl class="row">
      <dt class="col-sm-3"><%= t('activerecord.attributes.position.code') %></dt>
      <dd class="col-sm-9"><%= @org_position.position.code %></dd>

      <dt class="col-sm-3"><%= t('activerecord.attributes.position.name') %></dt>
      <dd class="col-sm-9"><%= @org_position.position.name %></dd>

      <dt class="col-sm-3"><%= t('admin.departments.table.name') %></dt>
      <dd class="col-sm-9"><%= @org_position.org_structure.department.name %></dd>

      <dt class="col-sm-3"><%= t('admin.menu.gestions') %></dt>
      <dd class="col-sm-9"><%= @org_position.gestion.name %></dd>

      <dt class="col-sm-3"><%= t('activerecord.attributes.position.status') %></dt>
      <dd class="col-sm-9"><span class="badge bg-<%= @org_position.position.active? ? 'success' : 'secondary' %>"><%= @org_position.position.status.humanize %></span></dd>
    </dl>

    <h5 class="mt-4"><%= t('admin.positions.assignments.title') %></h5>
    <% if @assignments.any? %>
      <table class="table table-sm">
        <thead>
          <tr>
            <th><%= t('admin.positions.assignments.personal') %></th>
            <th><%= t('admin.positions.assignments.start_date') %></th>
            <th><%= t('admin.positions.assignments.end_date') %></th>
            <th><%= t('activerecord.attributes.position.status') %></th>
          </tr>
        </thead>
        <tbody>
          <% @assignments.each do |assignment| %>
            <tr>
              <td><%= assignment.personal.full_name %></td>
              <td><%= assignment.start_date %></td>
              <td><%= assignment.end_date || t('admin.positions.assignments.ongoing') %></td>
              <td>
                <% if assignment.start_date.present? && assignment.start_date <= Date.current && (assignment.end_date.nil? || assignment.end_date >= Date.current) %>
                  <span class="badge bg-success"><%= t('admin.positions.assignments.active') %></span>
                <% else %>
                  <span class="badge bg-secondary"><%= t('admin.positions.assignments.inactive') %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-muted"><%= t('admin.positions.assignments.no_assignments') %></p>
    <% end %>
  </div>
</div>
