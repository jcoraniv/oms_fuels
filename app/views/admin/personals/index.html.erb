<% content_for :page_title, t('admin.personals.title') %>
<% content_for :page_actions do %>
  <%= link_to t('admin.personals.new'), new_admin_personal_path, class: 'btn btn-primary' %>
<% end %>

<div class="card">
  <div class="card-body p-0">
    <table class="table table-bordered table-hover dataTable dtr-inline">
      <thead>
        <tr>
          <th><%= t('admin.personals.table.first_name') %></th>
          <th><%= t('admin.personals.table.last_name') %></th>
          <th><%= t('admin.personals.table.email') %></th>
          <th><%= t('admin.personals.table.phone') %></th>
          <th><%= t('admin.personals.table.ci') %></th>
          <th><%= t('admin.personals.table.profession') %></th>
          <th style="width: 150px"><%= t('common.actions') %></th>
        </tr>
      </thead>
      <tbody>
        <% @personals.each do |personal| %>
          <tr>
            <td><%= link_to personal.first_name, admin_personal_path(personal), class: "text-primary" %></td>
            <td><%= personal.last_name %></td>
            <td><%= personal.email %></td>
            <td><%= personal.phone %></td>
            <td><%= personal.ci %></td>
            <td><%= personal.profession&.name %></td>
            <td>
              <%= action_button(:edit, edit_admin_personal_path(personal)) %>
              <%= action_button(:delete, admin_personal_path(personal), turbo_method: :delete, data: { turbo_confirm: t('common.confirm_delete') }) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="card-footer clearfix">
    <%= paginate @personals %>
  </div>
</div>
