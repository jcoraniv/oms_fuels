<% content_for :page_title do %>
  <%= link_to t('admin.menu.vehicle_types'), admin_vehicle_types_path %> /
  <%= @vehicle_type.name %>
<% end %>

<div class="card card-info">
  <div class="card-body">
    <div class="d-flex justify-content-end mb-3">
      <%= link_to edit_admin_vehicle_type_path(@vehicle_type), class: 'btn btn-warning btn-sm' do %>
        <i class="bi bi-pencil"></i>
      <% end %>
    </div>
    <dl class="row">
      <dt class="col-sm-3"><%= t('admin.vehicle_types.table.name') %></dt>
      <dd class="col-sm-9"><%= @vehicle_type.name %></dd>

      <dt class="col-sm-3"><%= t('admin.vehicle_types.table.description') %></dt>
      <dd class="col-sm-9"><%= @vehicle_type.description %></dd>
    </dl>
  </div>
</div>
