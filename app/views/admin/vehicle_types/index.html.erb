<div class="content-header">
  <div class="container-fluid">
    <div class="row mb-2">
      <div class="col-sm-6">
        <h1 class="m-0"><%= t('admin.vehicle_types.title') %></h1>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h3 class="card-title"><%= t('admin.vehicle_types.title') %></h3>
    <div class="card-tools">
      <%= link_to t('admin.vehicle_types.new'), new_admin_vehicle_type_path, class: "btn btn-primary" %>
    </div>
  </div>
  <div class="card-body p-0">
    <table class="table table-striped">
      <thead>
        <tr>
          <th><%= t('admin.vehicle_types.table.name') %></th>
          <th><%= t('admin.vehicle_types.table.description') %></th>
          <th style="width: 150px"><%= t('common.actions') %></th>
        </tr>
      </thead>
      <tbody>
        <% @vehicle_types.each do |vehicle_type| %>
          <tr>
            <td><%= vehicle_type.name %></td>
            <td><%= vehicle_type.description %></td>
            <td>
              <%= action_button(:show, admin_vehicle_type_path(vehicle_type)) %>
              <%= action_button(:edit, edit_admin_vehicle_type_path(vehicle_type)) %>
              <%= action_button(:delete, admin_vehicle_type_path(vehicle_type), turbo_method: :delete, data: { turbo_confirm: t('common.confirm_delete') }) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
