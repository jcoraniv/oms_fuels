<div class="content-header">
  <div class="container-fluid">
    <div class="row mb-2">
      <div class="col-sm-6">
        <h1 class="m-0"><%= t('admin.fuels.title') %></h1>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h3 class="card-title"><%= t('admin.fuels.title') %></h3>
    <div class="card-tools">
      <%= link_to t('admin.fuels.new'), new_admin_fuel_path, class: "btn btn-primary" %>
    </div>
  </div>
  <div class="card-body">
    <%= search_form_for @q, url: admin_fuels_path, method: :get, html: { class: 'mb-3' } do |f| %>
      <div class="row">
        <div class="col-md-6">
          <%= f.text_field :description_cont, class: 'form-control', placeholder: 'Search by description' %>
        </div>
        <div class="col-md-6">
          <%= f.submit 'Search', class: 'btn btn-primary' %>
          <%= link_to 'Reset', admin_fuels_path, class: 'btn btn-secondary' %>
        </div>
      </div>
    <% end %>
  </div>
  <div class="card-body p-0">
    <table class="table table-striped">
      <thead>
        <tr>
          <th><%= t('admin.fuels.table.description') %></th>
          <th><%= t('admin.fuels.table.unit_of_measure') %></th>
          <th><%= t('admin.fuels.table.reference_price') %></th>
          <th style="width: 150px"><%= t('common.actions') %></th>
        </tr>
      </thead>
      <tbody>
        <% @fuels.each do |fuel| %>
          <tr>
            <td><%= link_to fuel.description, admin_fuel_path(fuel), class: "text-primary" %></td>
            <td><%= t("activerecord.attributes.fuel.units_of_measure." + fuel.unit_of_measure) %></td>
            <td><%= number_to_currency(fuel.reference_price) if fuel.reference_price %></td>
            <td>
              <%= action_button(:edit, edit_admin_fuel_path(fuel)) %>
              <%= action_button(:delete, admin_fuel_path(fuel), turbo_method: :delete, data: { turbo_confirm: t('common.confirm_delete') }) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="card-footer clearfix">
    <%= paginate @fuels %>
  </div>
</div>
