<% content_for :page_title, t('admin.vehicles.title') %>
<% content_for :page_actions do %>
  <%= link_to t('admin.vehicles.new'), new_admin_vehicle_path, class: 'btn btn-primary' %>
<% end %>
<% content_for :table_filter do %>
  <%= search_form_for @q, url: admin_vehicles_path, method: :get do |f| %>
    <div class="row">
      <div class="col-md-4">
        <%= f.text_field :plate_cont, class: 'form-control', placeholder: t('admin.vehicles.table.plate') %>
      </div>
      <div class="col-md-4">
        <%= f.text_field :description_cont, class: 'form-control', placeholder: t('admin.vehicles.table.description') %>
      </div>
      <div class="col-md-4">
        <%= f.submit t('common.search'), class: 'btn btn-primary' %>
      </div>
    </div>
  <% end %>
<% end %>

<div class="card">
  <div class="card-body p-0">
    <table class="table table-bordered table-hover dataTable dtr-inline">
      <thead>
        <tr>
          <th><%= t('admin.vehicles.table.plate') %></th>
          <th><%= t('admin.vehicles.table.description') %></th>
          <th><%= t('admin.vehicles.table.details') %></th>
          <th><%= t('admin.vehicles.table.vehicle_type') %></th>
          <th><%= t('admin.vehicles.table.status') %></th>
          <th style="width: 150px"><%= t('common.actions') %></th>
        </tr>
      </thead>
      <tbody>
        <% @vehicles.each do |vehicle| %>
          <tr>
            <td><%= link_to vehicle.plate, admin_vehicle_path(vehicle), class: "text-primary" %></td>
            <td><%= vehicle.description %></td>
            <td><%= vehicle.details %></td>
            <td><%= vehicle.vehicle_type.name %></td>
            <td><span class="badge bg-<%= vehicle.status == 'active' ? 'success' : 'secondary' %>"><%= t("activerecord.attributes.vehicle.statuses.#{vehicle.status}") %></span></td>
            <td>
              <%= action_button(:edit, edit_admin_vehicle_path(vehicle)) %>
              <%= action_button(:delete, admin_vehicle_path(vehicle), turbo_method: :delete, data: { turbo_confirm: t('common.confirm_delete') }) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="card-footer clearfix">
    <%= paginate @vehicles %>
  </div>
</div>
