<li class="nav-item dropdown">
  <a class="nav-link" data-bs-toggle="dropdown" href="#">
    <i class="bi bi-bell"></i>
    <% if total_notifications_count(current_user) > 0 %>
      <span class="badge bg-warning navbar-badge"><%= total_notifications_count(current_user) %></span>
    <% end %>
  </a>
  <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
    <span class="dropdown-item dropdown-header"><%= total_notifications_count(current_user) %> Notifications</span>
    <% notifications_for_user(current_user).each do |notification| %>
      <div class="dropdown-divider"></div>
      <%= button_to notification[:url], method: :post, class: "dropdown-item text-start border-0 bg-transparent w-100 p-0", form: { style: "display: inline;" } do %>
        <span class="d-block px-3 py-2">
          <i class="<%= notification[:icon] %> me-2"></i> <%= notification[:count] %> <%= notification[:title] %>
        </span>
      <% end %>
    <% end %>
    <div class="dropdown-divider"></div>
    <a href="<%= admin_fuel_orders_path %>" class="dropdown-item dropdown-footer">See All Orders</a>
  </div>
</li>
